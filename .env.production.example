APP_NAME=Ecommerce
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=your_super_secret_password_here

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail & External Services (Resend)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="orders@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=re_your_api_key_here

FILESYSTEM_DISK=local
