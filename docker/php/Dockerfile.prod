# ==========================================
# Stage 1: Build Frontend Assets (Vite)
# ==========================================
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend
WORKDIR /app
COPY package*.json tsconfig*.json vite.config.js* ./
RUN npm ci
COPY resources/ resources/
COPY public/ public/
RUN npm run build

# ==========================================
# Stage 2: Install Composer Dependencies
# ==========================================
FROM --platform=$BUILDPLATFORM composer:2.8 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --optimize-autoloader

# ==========================================
# Stage 3: Production PHP 8.4-FPM Image
# ==========================================
FROM php:8.4-fpm-alpine

# Install production system dependencies and build libraries
# Note: libpq-dev is used instead of postgresql-dev to avoid heavy LLVM/Clang bloat
# Note: pdo, mbstring, xml, and opcache are already pre-compiled in php:8.4-fpm-alpine
RUN apk add --no-cache \
    curl \
    fcgi \
    bash \
    freetype \
    libpng \
    libjpeg-turbo \
    libzip \
    icu-libs \
    libpq \
    && apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    freetype-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libzip-dev \
    icu-dev \
    libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    pdo_pgsql \
    zip \
    exif \
    pcntl \
    bcmath \
    gd \
    intl \
    && apk del --no-network .build-deps

# Copy OPcache configuration
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# Set PHP production configuration
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

WORKDIR /var/www/html

# Copy application source
COPY . .

# Copy vendor dependencies from Stage 2
COPY --from=vendor /app/vendor/ /var/www/html/vendor/

# Copy compiled frontend assets from Stage 1
COPY --from=frontend /app/public/build/ /var/www/html/public/build/

# Set correct ownership for Laravel writable directories
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

USER www-data

EXPOSE 9000

CMD ["php-fpm"]
